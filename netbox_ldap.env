FILE__AUTH_LDAP_SERVER_URI=/run/secrets/ldap_server_uri
FILE__AUTH_LDAP_BIND_DN=/run/secrets/ldap_bind_dn
FILE__AUTH_LDAP_BIND_PASSWORD=/run/secrets/ldap_bind_password
FILE__AUTH_LDAP_USER_SEARCH_BASEDN=/run/secrets/ldap_user_search_basedn
FILE__AUTH_LDAP_GROUP_SEARCH_BASEDN=/run/secrets/ldap_group_search_basedn
FILE__AUTH_LDAP_IS_ADMIN_DN=/run/secrets/ldap_admin_group_dn
FILE__AUTH_LDAP_IS_SUPERUSER_DN=/run/secrets/ldap_superuser_group_dn

# LDAP további beállítások (nem titkos, közvetlenül env-ben)
AUTH_LDAP_GROUP_TYPE=NestedGroupOfNamesType
AUTH_LDAP_REQUIRE_GROUP_DN=
AUTH_LDAP_USER_ATTR_MAP=first_name:givenName,last_name:sn,email:mail
AUTH_LDAP_FIND_GROUP_PERMS=True
AUTH_LDAP_CACHE_TIMEOUT=3600
